{
  "json": {
  },
  "markdown": {
    "lineWidth": 120,
    "emphasisKind": "asterisks"
  },
  "toml": {
  },
  "yaml": {
  },
  // decisions/assets/template.md is tooling input, not prose: this formatter
  // rewrites its [{{placeholder}}] substitutions into [{ { placeholder } }],
  // which silently stops drs.py new from substituting anything.
  "excludes": [
    "**/*-lock.json",
    ".pebble/**",
    ".pi/**",
    "decisions/assets/**"
  ],
  "plugins": [
    "npm:@dprint/json@0.24.0",
    "npm:@dprint/markdown@0.24.0",
    "npm:@dprint/toml@0.8.0",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
